# Tessera — environment variables.
#
# Copy to `.env.local` and fill in. `.env*.local` is gitignored, so real keys
# never get committed. Keep THIS file valueless — it is committed.
#
# NEXT_PUBLIC_* are exposed to the browser BY DESIGN. For Supabase that is safe:
# the anon key only grants what the Row Level Security policies allow.

# --- REQUIRED. Without these, lib/supabase/client.ts throws at import and
# --- every route fails. Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OPTIONAL. Each feature degrades quietly when its key is absent.
# AI book/character generation (lib/gemini.ts, lib/book-ai.ts).
GEMINI_API_KEY=
# Image source — https://pro.europeana.eu/page/get-api (free). Skips itself if unset.
EUROPEANA_API_KEY=
# Image fallback for contemporary books — https://unsplash.com/developers. Skips itself if unset.
UNSPLASH_ACCESS_KEY=
# Image source — anonymous access is blocked (HTTP 429 on every request), so this
# source stays OFF unless you register a token at
# https://api.openverse.org/v1/auth_tokens/register/ . Skips itself if unset.
OPENVERSE_API_TOKEN=

# Canonical site URL, used for Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
